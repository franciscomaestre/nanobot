<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: replace __HOME__ before installing.
  Install:  cp to ~/Library/LaunchAgents/ after substitution.
  See CLAUDE.md § "launchd auto-restart" for the install script.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nanobot.gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-l</string>
    <string>__HOME__/.nanobot/bin/run-gateway.sh</string>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/.nanobot/logs/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.nanobot/logs/gateway.log</string>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
